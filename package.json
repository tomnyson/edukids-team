{
  "name": "claude-gui",
  "version": "0.1.0",
  "description": "A desktop GUI for the Claude CLI, with local SQLite history",
  "main": "./out/main/index.js",
  "author": "quangnvaws@gmail.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node test/db-companies.test.cjs && node test/stream-parser.test.cjs && node test/orchestrator.test.cjs && node test/opencode.test.cjs && node test/model-catalog.test.cjs && node test/agy-stream.test.cjs && node test/codex-stream.test.cjs && node test/cli-pick.test.cjs && node test/claude-model.test.cjs && node test/member-form.test.cjs && node test/meeting-folder.test.cjs && node test/mention.test.cjs && node test/mentioned-members.test.cjs && node test/meeting-context.test.cjs && node test/company-summaries.test.cjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "smoke": "electron-vite build && electron test/smoke.cjs",
    "test:ui": "electron-vite build && electron test/ui.cjs",
    "icons": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.33.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  },
  "productName": "Claude GUI"
}
